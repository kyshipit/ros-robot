<?xml version="1.0"?>
<!--
  mbot 两轮差速底盘城市模型（RK3588 EAI 平台）。

  坐标系（TF 树）：
    base_footprint ──(fixed)── base_link   ← base_footprint 为根（地面投影，无惯性）
       ├── (continuous) left_wheel_link
       ├── (continuous) right_wheel_link
       ├── (fixed) caster_wheel_link   (万向从动轮，纯几何，无主动关节)
       ├── (fixed) camera_link          ← eai_bot YOLO/SCRFD 镜头
       ├── (fixed) laser_link
       └── (fixed) imu_link

  说明：
    - 轮子用 continuous 关节（可无限旋转），真机/仿真阶段由
      diff_drive_controller / joint_state_broadcaster 驱动。
    - base_footprint 在底盘投影面的地面高度，供 Navigation 2D 导航使用。
-->
<robot name="mbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find mbot_description)/urdf/macros_common.xacro"/>
  <xacro:include filename="$(find mbot_description)/urdf/sensors.xacro"/>

  <!-- ===================== 可调参数（真机阶段改这里即可） ===================== -->
  <xacro:property name="chassis_length" value="0.45"/>   <!-- 底盘长 x -->
  <xacro:property name="chassis_width"  value="0.35"/>   <!-- 底盘宽 y -->
  <xacro:property name="chassis_height" value="0.10"/>   <!-- 底盘高 z -->

  <xacro:property name="wheel_radius"   value="0.08"/>   <!-- 轮半径 -->
  <xacro:property name="wheel_width"    value="0.04"/>   <!-- 轮宽 -->
  <xacro:property name="wheel_mass"     value="0.3"/>
  <xacro:property name="chassis_mass"   value="3.0"/>

  <xacro:property name="wheel_x"        value="-0.02"/>  <!-- 轮轴相对底盘中心的 x 偏移 -->
  <xacro:property name="wheel_y"        value="0.16"/>   <!-- 轮轴横向半间距 -->
  <xacro:property name="wheel_z"        value="-0.04"/>  <!-- 轮轴相对底盘中心下移 -->

  <!-- 万向从动轮在地面支撑（前/后），castor 几何。 -->
  <xacro:property name="caster_radius"  value="0.02"/>
  <xacro:property name="caster_x"       value="0.18"/>
  <xacro:property name="caster_z"       value="-0.06"/>

  <!-- ===================== 材质 ===================== -->
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="black"><color rgba="0.0 0.0 0.0 1"/></material>
  <material name="white"><color rgba="1.0 1.0 1.0 1"/></material>
  <material name="blue"><color rgba="0.2 0.4 0.9 1"/></material>

  <!-- ===================== base 连杆 ===================== -->
  <!--
    根 link 用 base_footprint（地面投影点，无惯性/几何），base_link 作为其子
    （本体，带惯性）。既符合 odom→base_footprint→base_link 的惯例，也避免
    KDL 不支持的「根 link 带惯性」问题。
  -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius - wheel_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- ===================== 左右驱动轮 ===================== -->
  <xacro:macro name="drive_wheel" params="side y_offset">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_offset} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <xacro:cylinder_inertia mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:drive_wheel side="left" y_offset="${wheel_y}"/>
  <xacro:drive_wheel side="right" y_offset="${-wheel_y}"/>

  <!-- ===================== 万向从动轮（前一个，纯几何） ===================== -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia mass="0.05" radius="${caster_radius}"/>
  </link>

  <!-- ===================== 传感器 ===================== -->
  <xacro:camera name="camera" parent="base_link" x="0.15" y="0" z="0.28" roll="0" pitch="0.15" yaw="0"/>
  <xacro:laser name="laser" parent="base_link" x="0.05" y="0" z="0.12" roll="0" pitch="0" yaw="0"/>
  <xacro:imu name="imu" parent="base_link" x="0" y="0" z="0.02" roll="0" pitch="0" yaw="0"/>

</robot>